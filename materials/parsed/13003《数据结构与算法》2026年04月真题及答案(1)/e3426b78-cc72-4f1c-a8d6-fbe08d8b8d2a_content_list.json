    },
    {
        "type": "code",
        "sub_type": "algorithm",
        "code_caption": [],
        "code_footnote": [],
        "code_body": "答案：(1)根结点是A。 (2)叶子结点是B、E、G、D。 (3)度是2。 (4)高度是4。  \n(5)C的孩子结点是E、F。",
